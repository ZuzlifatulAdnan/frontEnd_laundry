<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff">

    <!-- Header -->
    <LinearLayout
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#D32F2F"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:src="@android:drawable/sym_def_app_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_bg"
            android:padding="4dp"/>

        <TextView
            android:id="@+id/txtNamaUser"
            android:text="Hi, User"
            android:textColor="#fff"
            android:layout_marginStart="8dp"
            android:textSize="18sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Banner -->
    <ImageView
        android:id="@+id/bannerImage"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_launcher_background"
        android:layout_margin="8dp"/>

    <!-- Daftar Mesin -->
    <TextView
        android:text="Daftar Mesin"
        android:padding="8dp"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMesin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Bottom Nav -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#D32F2F"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView android:text="Beranda" android:textColor="#fff" android:layout_weight="1" android:gravity="center"/>
        <TextView android:text="Order" android:textColor="#fff" android:layout_weight="1" android:gravity="center"/>
        <TextView android:text="Riwayat" android:textColor="#fff" android:layout_weight="1" android:gravity="center"/>
        <TextView android:text="Akun" android:textColor="#fff" android:layout_weight="1" android:gravity="center"/>
    </LinearLayout>
</LinearLayout>
