<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CleanWashLaundromat" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Warna utama aplikasi (Merah dari konsep Anda) -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <!-- Varian lebih gelap dari warna utama, untuk status bar -->
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <!-- Warna teks di atas warna utama (misalnya, teks di tombol merah) -->
        <item name="colorOnPrimary">@color/white</item>

        <!-- Warna sekunder, untuk aksen atau komponen interaktif (Kuning/Amber dari konsep Anda) -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccent</item>
        <!-- Warna teks di atas warna sekunder -->
        <item name="colorOnSecondary">@color/black</item>

        <!-- Warna status bar -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Customize your theme here. -->
    </style>
    <style name="DetailLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/grey_dark</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DetailValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Theme.CleanWashLaundromat" parent="Base.Theme.CleanWashLaundromat" />
</resources>